const languages = ["en", "zu", "es"];

let objectIndex = 0;
let languageIndex = 0;

const picture = document.getElementById("picture");

function showObject() {

    picture.textContent = objects[objectIndex].picture;

}

function speakWord() {

    const object = objects[objectIndex];
    const language = languages[languageIndex];

    const word = object.words[language];

    if (!("speechSynthesis" in window)) {
        return;
    }

    window.speechSynthesis.cancel();

    const utterance = new SpeechSynthesisUtterance(word);

    if (language === "en") {
        utterance.lang = "en-ZA";
    }

    if (language === "zu") {
        utterance.lang = "zu-ZA";
    }

    if (language === "es") {
        utterance.lang = "es-ES";
    }

    utterance.rate = 0.75;
    utterance.pitch = 1.05;
    utterance.volume = 1.0;

    window.speechSynthesis.speak(utterance);

    picture.classList.remove("listened");

    void picture.offsetWidth;

    picture.classList.add("listened");

    advance();

}

function advance() {

    languageIndex++;

    if (languageIndex >= languages.length) {

        languageIndex = 0;

        objectIndex++;

        if (objectIndex >= objects.length) {
            objectIndex = 0;
        }

    }

    showObject();

}

picture.addEventListener("click", speakWord);

picture.addEventListener("touchend", function(event) {

    event.preventDefault();

});

showObject();

